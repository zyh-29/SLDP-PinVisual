{
  "name": "pinvisual",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fast-png": "8.0.0",
    "onnxruntime-web": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "3.5.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "^58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/web-offline.mjs && node scripts/web-routes.mjs",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:firmware": "mkdir -p node_modules/.cache && c++ -std=c++17 -Wall -Wextra -Werror -o node_modules/.cache/firmware-protocol-test firmware/test/protocol_test.cpp firmware/pinvisual-esp32/protocol.cpp && node_modules/.cache/firmware-protocol-test",
    "build:android:dev": "npx eas-cli@latest build --profile development --platform android",
    "postinstall": "node scripts/copy-ort.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|fast-png|iobuffer|fflate)"
    ]
  }
}
