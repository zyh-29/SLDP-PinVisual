{
  "expo": {
    "name": "PinVisual",
    "slug": "pinvisual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinvisual",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sldp.pinvisual",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sldp.pinvisual"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "PinVisual",
      "shortName": "PinVisual",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7",
      "description": "Turn images into raised-pin patterns for a tactile display."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "PinVisual uses Bluetooth to send pin patterns to your tactile display.",
          "neverForLocation": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinVisual uses your photos to turn a picture into a raised-pin pattern.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
