{
  "expo": {
    "name": "PinVisual",
    "slug": "pinvisual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinvisual",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "bundleIdentifier": "com.sldp.pinvisual",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sldp.pinvisual",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "PinVisual",
      "shortName": "PinVisual",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7",
      "description": "Turn images into raised-pin patterns for a tactile display."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "PinVisual uses Bluetooth to send pin patterns to your tactile display.",
          "neverForLocation": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinVisual uses your photos to turn a picture into a raised-pin pattern.",
          "cameraPermission": false,
          "microphonePermission": "PinVisual uses the microphone for voice commands, such as \"show a circle\" or \"send\"."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PinVisual uses the microphone for voice commands, such as \"show a circle\" or \"send\".",
          "speechRecognitionPermission": "PinVisual turns what you say into commands on this device. Nothing is stored.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./modules/subject-segmentation/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a7ce94ca-27c6-4017-a719-bec3f6a80434"
      }
    },
    "owner": "zyh-29"
  }
}
