{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "WEB_BASE_URL=/pinvisual npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/pinvisual/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/pinvisual", "destination": "/index.html" },
    { "source": "/pinvisual/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/pinvisual/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/pinvisual/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/pinvisual/(models|ort|tesseract)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
